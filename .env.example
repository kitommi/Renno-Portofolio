# Salin file ini menjadi .env lalu isi nilainya.
# Endpoint Formspree untuk formulir kontak, contoh: https://formspree.io/f/xxxxxxxx
VITE_FORMSPREE_ENDPOINT=

# URL produksi website (opsional). Di Vercel diisi otomatis; isi manual jika memakai domain sendiri,
# contoh: https://renno.dev
VITE_SITE_URL=
